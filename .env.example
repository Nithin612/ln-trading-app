# Copy to .env and fill in real values. Never commit .env to git.
# Generate secrets with: openssl rand -hex 32

# ───────────────────────── Postgres ─────────────────────────
POSTGRES_USER=tpuser
POSTGRES_PASSWORD=changeme_use_openssl_rand_hex_16
POSTGRES_DB=trading_platform

# Async URL used by SQLAlchemy + asyncpg (backend code path).
# NOTE the port: docker-compose maps postgres to HOST PORT 5433 (5432 is
# left free for any system postgres).
DATABASE_URL=postgresql+asyncpg://tpuser:changeme_use_openssl_rand_hex_16@localhost:5433/trading_platform

# Sync URL used by Alembic migrations (sync driver only)
DATABASE_URL_SYNC=postgresql+psycopg://tpuser:changeme_use_openssl_rand_hex_16@localhost:5433/trading_platform

# ───────────────────────── Redis ────────────────────────────
REDIS_URL=redis://localhost:6379/0
# DB 0: app cache + pub/sub
# DB 1: Celery broker
# DB 2: Celery result backend
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ───────────────────────── JWT auth ─────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_64_char_hex_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=45
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ──────────────────── Zerodha Kite Connect ──────────────────
# Get from https://developers.kite.trade after creating an app.
# Optional until you want LIVE market data — EOD ingestion and the F&O
# recorders run off free NSE archives without it.
KITE_API_KEY=
KITE_API_SECRET=
KITE_REDIRECT_URL=http://127.0.0.1:8000/api/v1/broker/kite/callback
# The access token DIES ~6:00 AM IST daily (normal lifecycle, not an
# error). Daily ritual: cd backend && uv run python scripts/kite_login.py
KITE_ACCESS_TOKEN=

# ─────────────── Live worker (v2 Phase 3, optional) ─────────
# Record the exact tick+pulse input stream as JSONL for deterministic
# replay (empty = off). Run the worker via `make live-worker`.
#LIVE_RECORD_PATH=
# Trigger-engine tuning (defaults shown; see app/core/config.py)
#LIVE_LEVEL_REFRESH_S=30
#LIVE_ENTRY_ZONE_PCT=0.5
#LIVE_ALERT_STREAM=alerts:live

# ──────────────── Engine selection (v2 Phase 1+) ────────────
# "python" = frozen pandas reference · "rust" = tradecore (parity-gated)
#ENGINE_IMPL=python

# ──────────────── F&O chain recorder (Phase 0) ───────────────
# Underlyings snapshotted every minute during market hours (needs Kite token)
FO_CHAIN_UNDERLYINGS=NIFTY,BANKNIFTY
# Keeps the 2N+1 strikes nearest to spot for the nearest expiry
FO_CHAIN_STRIKES_EACH_SIDE=10

# ─────────────────────── pgAdmin (dev) ──────────────────────
[email protected]
PGADMIN_PASSWORD=admin

# ─────────────────────── App config ─────────────────────────
APP_ENV=development              # development | staging | production
APP_DEBUG=true
LOG_LEVEL=DEBUG                  # DEBUG | INFO | WARNING | ERROR
APP_HOST=0.0.0.0
APP_PORT=8000

# CORS — JSON array (pydantic-settings parses list fields as JSON; the
# old comma-separated form fails validation)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ─────────────────────── Trading config ─────────────────────
# Default risk per trade as a fraction of capital (Class 10 rule)
DEFAULT_RISK_PER_TRADE_PCT=2.0
# Minimum confluence confidence (0-100) before a signal is shown
MIN_SIGNAL_CONFIDENCE=70
# Trading hours (24h IST)
MARKET_OPEN_HOUR=9
MARKET_OPEN_MINUTE=15
MARKET_CLOSE_HOUR=15
MARKET_CLOSE_MINUTE=30

# ─────────────── Signal eligibility overlays (gate modes) ───────────────
# Every overlay is downstream of the FROZEN confluence engine and takes one of:
#   off    — true no-op (no read, no stamp)
#   shadow — verdict computed for MEASUREMENT only; the order path never acts
#   active — the order path REJECTS an ineligible signal (behaviour-changing)
# A shadow→active flip needs the sidecar's pre-registered bar met (20 resolved
# would-block trades) AND explicit user sign-off. Every flip is reversible.
# Readiness banners: docs/analysis/<gate>-shadow-<date>.md, via `make analysis`.
#
# ACTIVE — enforces the "≥2 factors, never a single indicator" rule (SIGNAL_ENGINE §2).
ENTRY_DIVERSITY_GATE_MODE=active
# SHADOW — reverted from active 2026-09-02: 88 resolved suppressed trades came in
# net-POSITIVE (+0.090 expR) on the live tape for 7 straight report days, so the §8
# backtest finding is not reproducing forward.
# See docs/analysis/regime-gate-revert-2026-09-02.md
REGIME_GATE_MODE=shadow
# SHADOW — stop-too-tight (|entry−SL| < k·ATR). 17/20 resolved; closest to a decision.
ENTRY_SL_ATR_GATE_MODE=shadow
# SHADOW — anti-chase (live price > chase_max_r × 1R past entry). 4/20 resolved.
CHASE_GATE_MODE=shadow
# SHADOW — median-daily-traded-value floor. 19/20 resolved, but the 5a deep-dive
# ruled DON'T flip (the illiquid set is net-positive); reframe as a sizing modifier.
LIQUIDITY_GATE_MODE=shadow
# SHADOW — skips entries pinned near the ADVERSE circuit band. 0/20 resolved.
CIRCUIT_GATE_MODE=shadow
# SHADOW — sector/index relative strength. Would-block set is NOT worse than eligible.
SECTOR_RS_GATE_MODE=shadow
# SHADOW — market regime (200-DMA + VIX). Backfill DONE (782 bars/index), so it is NOT
# inert. ⛔ Its banner reads READY — do not flip: it is measuring SIDE, not regime.
MARKET_REGIME_GATE_MODE=shadow
# SHADOW — reverted 2026-09-03, one day after shipping ACTIVE. It was promoted without a
# forward-evidence bar on the argument that it enforces an IDENTITY rather than a
# hypothesis: at planned R:R < 1 a trade needs a >50% win rate merely to break even,
# "which no trend-following system sustains". The arithmetic held; that last clause was an
# unchecked assertion and the tape falsified it in a week. The blocked cohort was the
# book's ONLY profitable one — 24 trades, +₹10,585, 63% win, 33% tp_hit — because a nearer
# target is mechanically easier to hit, and because R:R < 1 is a PROXY FOR A WIDE STOP
# (7.29% avg, zero tight) and wide stops are independently the good cohort. It blocked
# wide stops. Backwards. Re-promotion needs the deflated-Sharpe bar and a tail check, not
# the identity argument again; raising RR_MIN above 1.0 is doubly empirical (1.67 is
# fitted to our observed 37.5% win rate).
RR_GATE_MODE=shadow
RR_MIN=1.0

# ─────────────── Paper account constraints ───────────────
# Per-position NOTIONAL cap as a multiple of capital. risk-first sizing bounds a trade's
# RISK but not its SIZE: a stop a few paise wide sized 50,000 shares = ₹1,18,65,000 on
# ₹1,00,000 of capital (2026-09-02) — 119x the account, polluting the paper book, the R
# statistics and the 30-day go-live clock. 1.0 = NSE cash-delivery reality (no leverage:
# you cannot buy more stock than you have money). 0 disables the cap.
# NOTE: PER POSITION. Portfolio-wide exposure needs the heat cap (not built — the book ran
# at 45.3% risk across 23 positions).
PAPER_MAX_NOTIONAL_LEVERAGE=1.0

# Declared notional account size the PAPER SAMPLER represents — REPORTING ONLY.
# `capital_inr` (the live figure, ₹1L) drives all sizing and must not change. But the
# paper book is deliberately a wide evidence sampler (~5 entries/day, ~5-day holds ⇒ ~25
# concurrent positions), so exposure against ₹1L reads 45.3% "heat" while the very same
# positions are 9.1% against the ₹5L the sampler actually stands for. Same book, different
# denominator. The daily report prints BOTH, labelled. 0/absent = previous behaviour.
# NEVER touches compute_quantity/size_for_fill, so no trade changes size.
PAPER_SAMPLING_CAPITAL_INR=500000
# Cap used by the heat COUNTERFACTUAL only — enforces nothing. Elder's 6% rule. Answers
# the question the 30-day clock should be reading: "what would a disciplined ₹1L book have
# returned from the same signals?" See docs/analysis/heat-counterfactual-<date>.md.
HEAT_COUNTERFACTUAL_PCT=6.0

# ── Portfolio HEAT CAP (Phase 7.1 — app/trading/risk_engine.py) ──────────────
# The ENFORCING sibling of HEAT_COUNTERFACTUAL_PCT. Admission risk summed across OPEN
# positions: heat = qty × max(0, entry − commit_SL). Initial risk, never mark-to-market
# (a from-the-mark definition LOOSENS as the book deteriorates — perverse for a risk
# cap), and from the COMMIT stop, never the trailed current_sl (which would let the book
# gain budget merely by being right).
#
# ⚠ SHIP IT `off` UNTIL THE CYCLE-2 RESET. A 6% cap cuts cycle-1 entries ~74%, and cycle
# 1 exists to accrue evidence VOLUME. The counterfactual already answers what a cap would
# answer with no behaviour change: admitted 12 / skipped 35, total better (+₹5,790) but
# PER-TRADE WORSE (−₹1,478 vs −₹796) ⇒ a heat cap is a RISK control, not a profitability
# fix. Flip to `active` when the cycle-2 clock starts.
#
# ⚠ Unlike the selection overlays this rail FAILS CLOSED: an open position whose risk
# cannot be measured refuses the NEXT entry rather than counting as zero. For a selection
# gate the error to avoid is suppressing a good trade; for a risk rail it is taking risk
# you cannot count. Same logic as the daily-loss breaker.
#
# ⚠ The denominator is CAPITAL_INR (the live figure), never PAPER_SAMPLING_CAPITAL_INR —
# that one is reporting-only and 5× larger, so misapplying it quintuples the cap.
HEAT_CAP_MODE=off
HEAT_CAP_PCT=6.0

# ── Portfolio position-count cap (D4, 2026-09-08) ─────────────────────────────
# Max CONCURRENT open positions. At cycle-2 scale (₹1L, the live 1–2 book) a heat % barely
# binds, so the COUNT is the concentration rail that actually bites and enforces the 1–2
# design intent. A HARD design rail (no edge bar); adding to an existing position is exempt.
# `off` during the cycle-1 sampler (~25 concurrent by design); flips to `active` at the
# cycle-2 reset alongside the heat cap. 0 or negative = disabled.
POSITION_COUNT_CAP_MODE=off
MAX_CONCURRENT_POSITIONS=3

# ── Tick grid (B3, 2026-09-11) ───────────────────────────────────────────────
# ⭐ 0 (the default) = use `app/broker/tick_schedule.py`, the DATED PRICE-BAND schedule.
# NSE moved sub-₹250 names to a ₹0.01 tick during June 2024 while ≥₹250 stayed on ₹0.05.
# A single ₹0.05 constant charged a ₹39 name ~10 bps of round-trip rounding the market
# does not levy — ≈0.051R at a 2% stop, about 40% of the real 25.5 bps charge stack, and
# concentrated on exactly the cheap tight-stop cohort.
#
# A POSITIVE value forces that flat grid everywhere and ignores the schedule — kept for
# tests and for pinning a historical model, not for production.
# ⚠ Negative disables rounding entirely and nothing ships that way: an off-grid price is
# not transactable, so skipping the snap hands out fills BETTER than reality.
#
# ⚠ The band boundary is ₹225, not ₹250 — measured, ₹225–₹300 is a MIXED zone because the
# tick is a property of the instrument (set at a review, sticky) rather than of the current
# price. Taking the low end can only ever make a fill worse, which is the module contract.
PAPER_TICK_SIZE=0

# ── Aggregate cash constraint (B2, 2026-09-11) ───────────────────────────────
# ⛔ Before this the constraint DID NOT EXIST ANYWHERE — not in the paper broker, not in
# the RiskEngine, not in the backtest. The per-position notional cap bounds ONE trade
# against capital; nothing bounded the SUM. Three slots at the median 5% swing stop need
# ~120% of capital and every one of them returned 201.
#
# It enforces an IDENTITY — a delivery account cannot deploy money it does not have — so
# it carries NO forward-evidence bar, unlike the six selection overlays. A rail, not a gate.
#
# ⚠ Always measurable, so it has NO fail-closed branch: a position with no recoverable
# stop still has a price and a quantity, and its notional is counted even when the heat
# cap cannot count its risk.
#
# ⚠ The denominator is CAPITAL_INR (the live figure), never PAPER_SAMPLING_CAPITAL_INR.
# CASH_CAP_LEVERAGE is the multiple of capital the book may deploy; 1.0 = strictly
# cash-and-carry. 0 or negative = disabled.
#
# `off` during the cycle-1 sampler (~25 concurrent by design, which this would throttle to
# a stop); flips `active` at the cycle-2 reset alongside the heat and position-count caps.
CASH_CAP_MODE=off
CASH_CAP_LEVERAGE=1.0

# ── Kill switch (Phase 7.4) ──────────────────────────────────────────────────
# The human's stop. `true` halts all NEW ENTRIES at the first rule the RiskEngine runs,
# ahead of even the daily-loss breaker.
# ⚠ IT DOES NOT BLOCK EXITS, deliberately — a switch that traps you in open positions is a
# hazard dressed as a safety feature. The moment you most want to halt new risk is often
# the moment you most need to close what you already hold.
# ⚠ Plain bool, no "shadow" mode: a kill switch you can set to measure-only is not one.
# ⚠ `settings` is an @lru_cache singleton — flipping this reaches a RUNNING backend/worker
# only after that process re-imports config. VERIFY IT IN THE LIVE PROCESS, not the file.
TRADING_KILL_SWITCH=false

# ── Session notifier (A11) ───────────────────────────────────────────────────
# Where the notifier POSTs. UNSET IS THE DEFAULT AND IS NOT A DEGRADED MODE: the noise
# policy still runs and still logs at the level it chose; setting this only adds a push.
# The notifier exists to retire two standing manual daily checks — CAS capture (the worker
# must be up 15:15–15:33 IST and A MISSED WINDOW CANNOT BE BACK-FILLED) and provisional
# health (which has no scheduler at all). Both are currently caught by someone remembering.
#
# The policy: routine success is SILENT (the artifact is the confirmation), repeats are
# throttled with the suppressed count carried on the next message, and ANY EXCEPTION ALWAYS
# NOTIFIES, bypassing every rule including the throttle.
#
# ⚠ A quiet channel does NOT mean the capture worked. This reports what RAN; the CAS alarm
# we actually want is an ABSENCE (the window passed, nothing was written) and no `finally`
# fires for that — it needs the scheduled liveness check (A40).
#
# Vendor-neutral JSON POST: {event, level, title, text, content}. Slack and Discord accept
# it as-is; Telegram/ntfy want a small relay. A delivery failure is swallowed by design.
# NOTIFIER_WEBHOOK_URL=https://hooks.slack.com/services/...
