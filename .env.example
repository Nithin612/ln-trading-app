# Copy to .env and fill in real values. Never commit .env to git.
# Generate secrets with: openssl rand -hex 32

# ───────────────────────── Postgres ─────────────────────────
POSTGRES_USER=tpuser
POSTGRES_PASSWORD=changeme_use_openssl_rand_hex_16
POSTGRES_DB=trading_platform

# Async URL used by SQLAlchemy + asyncpg (backend code path).
# NOTE the port: docker-compose maps postgres to HOST PORT 5433 (5432 is
# left free for any system postgres).
DATABASE_URL=postgresql+asyncpg://tpuser:changeme_use_openssl_rand_hex_16@localhost:5433/trading_platform

# Sync URL used by Alembic migrations (sync driver only)
DATABASE_URL_SYNC=postgresql+psycopg://tpuser:changeme_use_openssl_rand_hex_16@localhost:5433/trading_platform

# ───────────────────────── Redis ────────────────────────────
REDIS_URL=redis://localhost:6379/0
# DB 0: app cache + pub/sub
# DB 1: Celery broker
# DB 2: Celery result backend
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ───────────────────────── JWT auth ─────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_64_char_hex_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=45
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ──────────────────── Zerodha Kite Connect ──────────────────
# Get from https://developers.kite.trade after creating an app.
# Optional until you want LIVE market data — EOD ingestion and the F&O
# recorders run off free NSE archives without it.
KITE_API_KEY=
KITE_API_SECRET=
KITE_REDIRECT_URL=http://127.0.0.1:8000/api/v1/broker/kite/callback
# The access token DIES ~6:00 AM IST daily (normal lifecycle, not an
# error). Daily ritual: cd backend && uv run python scripts/kite_login.py
KITE_ACCESS_TOKEN=

# ─────────────── Live worker (v2 Phase 3, optional) ─────────
# Record the exact tick+pulse input stream as JSONL for deterministic
# replay (empty = off). Run the worker via `make live-worker`.
#LIVE_RECORD_PATH=
# Trigger-engine tuning (defaults shown; see app/core/config.py)
#LIVE_LEVEL_REFRESH_S=30
#LIVE_ENTRY_ZONE_PCT=0.5
#LIVE_ALERT_STREAM=alerts:live

# ──────────────── Engine selection (v2 Phase 1+) ────────────
# "python" = frozen pandas reference · "rust" = tradecore (parity-gated)
#ENGINE_IMPL=python

# ──────────────── F&O chain recorder (Phase 0) ───────────────
# Underlyings snapshotted every minute during market hours (needs Kite token)
FO_CHAIN_UNDERLYINGS=NIFTY,BANKNIFTY
# Keeps the 2N+1 strikes nearest to spot for the nearest expiry
FO_CHAIN_STRIKES_EACH_SIDE=10

# ─────────────────────── pgAdmin (dev) ──────────────────────
[email protected]
PGADMIN_PASSWORD=admin

# ─────────────────────── App config ─────────────────────────
APP_ENV=development              # development | staging | production
APP_DEBUG=true
LOG_LEVEL=DEBUG                  # DEBUG | INFO | WARNING | ERROR
APP_HOST=0.0.0.0
APP_PORT=8000

# CORS — JSON array (pydantic-settings parses list fields as JSON; the
# old comma-separated form fails validation)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ─────────────────────── Trading config ─────────────────────
# Default risk per trade as a fraction of capital (Class 10 rule)
DEFAULT_RISK_PER_TRADE_PCT=2.0
# Minimum confluence confidence (0-100) before a signal is shown
MIN_SIGNAL_CONFIDENCE=70
# Trading hours (24h IST)
MARKET_OPEN_HOUR=9
MARKET_OPEN_MINUTE=15
MARKET_CLOSE_HOUR=15
MARKET_CLOSE_MINUTE=30
